{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "marketing",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/submitCustomerForm",
          "function": {
            "functionId": "submitCustomerForm",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/submitWebsiteContactForm",
          "function": {
            "functionId": "submitWebsiteContactForm",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/testAndSaveSmtpSettings",
          "function": {
            "functionId": "testAndSaveSmtpSettings",
            "region": "australia-southeast1"
          }
        }
      ]
    },
    {
      "target": "app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
